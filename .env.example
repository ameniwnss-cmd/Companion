# Copy to `backend/.env` for local development. Never commit real secrets.
# Every value below has a safe default, so the app and tests run without this file.

# --- Backend
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:4200"]
DATABASE_URL=postgresql+asyncpg://companion:companion@localhost:5433/companion
# Dev-only text chat (http://localhost:4200/dev). Forced off when ENVIRONMENT=production.
DEV_TEXT_CHANNEL=true
DEV_USER_EMAIL=dev@companion.local

# --- Reminders: how often due reminders are checked
REMINDER_LOOP_ENABLED=true
REMINDER_POLL_SECONDS=30

# --- Language model: fake | ollama | groq   (see docs/adr/0002-ai-providers.md)
LLM_PROVIDER=ollama
LLM_TIMEOUT_SECONDS=30
# Groq free tier: create a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Ollama, running locally: https://ollama.com
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M

# --- Memory: embeddings for recalling what matters (fake | ollama)
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=all-minilm
MEMORY_EXTRACTION_ENABLED=true

# --- Voice: speech-to-text (fake | groq) and the companion's voice (fake | kokoro)
# Kokoro model files: see README, they go in backend/.models/kokoro/
STT_PROVIDER=groq
TTS_PROVIDER=kokoro
KOKORO_VOICE=bm_fable

# --- Docker Compose database
POSTGRES_USER=companion
POSTGRES_PASSWORD=companion
POSTGRES_DB=companion
POSTGRES_PORT=5433
